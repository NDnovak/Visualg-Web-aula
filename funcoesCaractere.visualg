algoritmo "funcoesCaractere"

var
  texto: caractere

inicio
  texto <- "Danilo"

  escreval("Texto original: ", texto)
  escreval("Cópia de parte do texto: ", copia (texto, 1, 3))
  escreval("Quantidade de caracteres: ", compr (texto))
  escreval("Texto em maiúsculas: ", maiusc(texto))
  escreval("Texto em micúsculas: ", minusc(texto))
  escreval("Posição de 'ni': ", pos("ni", texto))

fimalgoritmo